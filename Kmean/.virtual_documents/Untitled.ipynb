import seaborn as sns
from sklearn.datasets import make_blobs


x , y = make_blobs(
    n_samples = 1000, 
    n_features = 2 ,
     centers = 4,
    random_state = 42
)


sns.scatterplot(x = x[:,0],y = x[:,1])


from sklearn.cluster import KMeans


k = 4

kmean = KMeans (
    n_clusters = k,
    random_state = 42
)


labels = kmean.fit_predict(x);










